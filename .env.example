PORT=4242

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=<your-stripe-test-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-test-publishable-key>
# Only needed once the webhook endpoint is wired up (see stripe listen)
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=payments-app
